# ==============================================================================
#  KALACETU (कला-सेतु) CONFIGURATION FILE
#  This file controls your Server, Database, and AI integrations.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# DATABASE_TYPE options:
#   - "embedded" : (Default) Works instantly with ZERO setup! Stores data in server/data/
#   - "mongodb"  : Connects to MongoDB Atlas or local MongoDB
#   - "postgres" : Connects to PostgreSQL or Supabase
DATABASE_TYPE=embedded

# If DATABASE_TYPE=mongodb, paste your MongoDB connection string below:
# Example: mongodb+srv://myUser:myPassword@cluster0.mongodb.net/kalasetu?retryWrites=true&w=majority
DATABASE_URL=mongodb://localhost:27017/kalasetu

# If DATABASE_TYPE=postgres, paste your PostgreSQL / Supabase connection string:
# Example: postgresql://postgres:myPassword@db.supabase.co:5432/postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/kalasetu_db


# ------------------------------------------------------------------------------
# 2. AI / ML API KEYS (Optional for Gemini / Bhashini)
# ------------------------------------------------------------------------------
# Get a free Gemini API key from: https://aistudio.google.com/app/apikey
# If left empty, the server will automatically use the built-in Intelligent
# Offline Rule-Based NLP Engine (supports Hindi, Hinglish, Bengali & English).
GEMINI_API_KEY=


# ------------------------------------------------------------------------------
# 3. SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
# PORT: The port your server will listen on. Default: 5000
PORT=5000

# HOST: "0.0.0.0" allows other phones & PCs on your Wi-Fi to access this server.
HOST=0.0.0.0

# APP ENVIRONMENT: 'development' or 'production'
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. WHATSAPP WEB AUTOMATION NOTIFICATIONS (whatsapp-web.js)
# ------------------------------------------------------------------------------
# Phone numbers must include country code without '+' (e.g. 919XXXXXXXXX)
SELLER_NUMBER=917815028355
DELIVERY_AGENT_NUMBER=919668317789
COMPANY_NUMBER=916371205518
